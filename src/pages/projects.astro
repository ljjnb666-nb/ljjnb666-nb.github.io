---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';

const statusLabel = { live: '已上线', wip: '开发中', placeholder: '示例' } as const;
---

<BaseLayout title="作品" nav="projects" wide>
  <div class="page-head">
    <h1>作品</h1>
    <p>实际开发的项目、演示、技术方案和复盘。</p>
  </div>

  <div class="cards">
    {projects.map((p) => <ProjectCard p={p} statusLabel={statusLabel} />)}
  </div>

  <p style="color: var(--muted); font-size: 0.9rem; margin-top: 2rem;">
    项目数据来自 <code>src/data/projects.ts</code>，加项目只改那一个文件。
  </p>
</BaseLayout>
