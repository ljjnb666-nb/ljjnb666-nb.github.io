---
// 全站浮动 AI 助手：BYOK 模式
// - 访客自填 OpenAI-compatible 的 base URL + API Key + 模型名
// - 只存浏览器 localStorage，不经过任何后端（本站是纯静态的，没有后端）
// - 问答时把本站文章内容注入 system prompt，实现"基于本站内容问答"
interface Article {
  title: string;
  slug: string;
  body: string;
}
interface Props {
  articles: Article[];
  brand: string;
  signature: string;
}
const { articles, brand, signature } = Astro.props;
const safe = (s: string) => s.replace(/</g, '\\u003c');
const articlesJson = safe(JSON.stringify(articles));
---

<button id="ask-fab" class="ask-fab" aria-label="打开站内 AI 助手">
  <span class="spark">✦</span> 问 AI
</button>

<aside id="ask-panel" class="ask-panel" hidden aria-label="站内 AI 助手">
  <div class="ask-head">
    <span>✦ 站内 AI 助手</span>
    <button id="ask-close" aria-label="关闭">×</button>
  </div>

  <div class="ask-secure">
    🔒 BYOK 模式：你的 API Key 只保存在本浏览器 localStorage，
    请求直接发往你填写的 API 地址。本站是纯静态的、没有后端，
    Key 不会经过任何本站服务器。
  </div>

  <details class="ask-settings">
    <summary>⚙ 设置（base URL / Key / 模型）</summary>
    <label>Base URL（OpenAI-compatible）
      <input id="ask-base" placeholder="https://api.openai.com/v1" autocomplete="off" spellcheck="false" />
    </label>
    <label>API Key
      <input id="ask-key" type="password" placeholder="sk-…" autocomplete="off" spellcheck="false" />
    </label>
    <label>模型
      <input id="ask-model" placeholder="gpt-4o-mini" autocomplete="off" spellcheck="false" />
    </label>
    <button id="ask-save">保存到本机浏览器</button>
  </details>

  <div id="ask-msgs" class="ask-msgs"></div>

  <div class="ask-input-row">
    <input id="ask-input" placeholder="就本站内容提问…" aria-label="向 AI 助手提问" />
    <button id="ask-send">发送</button>
  </div>
</aside>

<script define:vars={{ articlesJson, brand, signature }}>
  const articles = JSON.parse(articlesJson);
  const LS_BASE = 'zhizao_ask_base';
  const LS_KEY = 'zhizao_ask_key';
  const LS_MODEL = 'zhizao_ask_model';

  const fab = document.getElementById('ask-fab');
  const panel = document.getElementById('ask-panel');
  const closeBtn = document.getElementById('ask-close');
  const msgs = document.getElementById('ask-msgs');
  const input = document.getElementById('ask-input');
  const sendBtn = document.getElementById('ask-send');
  const baseInput = document.getElementById('ask-base');
  const keyInput = document.getElementById('ask-key');
  const modelInput = document.getElementById('ask-model');
  const saveBtn = document.getElementById('ask-save');

  const esc = (s) =>
    String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  // 恢复本地设置
  baseInput.value = localStorage.getItem(LS_BASE) || '';
  modelInput.value = localStorage.getItem(LS_MODEL) || '';
  if (localStorage.getItem(LS_KEY)) keyInput.placeholder = '已保存（●●●●）';

  function addMsg(kind, text) {
    const d = document.createElement('div');
    d.className = `msg ${kind}`;
    d.innerHTML = esc(text).replace(/\n/g, '<br>');
    msgs.appendChild(d);
    msgs.scrollTop = msgs.scrollHeight;
    return d;
  }

  function togglePanel() {
    panel.hidden = !panel.hidden;
    if (!panel.hidden) input.focus();
  }

  fab.addEventListener('click', togglePanel);
  closeBtn.addEventListener('click', () => {
    panel.hidden = true;
  });

  saveBtn.addEventListener('click', () => {
    const base = baseInput.value.trim();
    const key = keyInput.value.trim();
    const model = modelInput.value.trim();
    if (base) localStorage.setItem(LS_BASE, base);
    if (key) {
      localStorage.setItem(LS_KEY, key);
      keyInput.value = '';
      keyInput.placeholder = '已保存（●●●●）';
    }
    if (model) localStorage.setItem(LS_MODEL, model);
    addMsg('sys', '设置已保存到本机浏览器。');
  });

  function buildSystemPrompt() {
    const context = articles
      .map((a) => `\n${String(a.body || '').slice(0, 4000)}`)
      .join('\n\n---\n\n');
    return (
      `你是「${brand}」（${signature}）博客的站内问答助手。` +
      `请只根据以下本站文章内容回答用户问题；` +
      `如果文章里没有相关信息，请明确说"本站文章里没提到"，不要编造。` +
      `回答用中文，简洁。\n\n本站文章内容：\n${context}`
    );
  }

  let thinkingEl = null;

  async function send() {
    const q = input.value.trim();
    if (!q || thinkingEl) return;
    const base = (
      localStorage.getItem(LS_BASE) ||
      baseInput.value.trim() ||
      'https://api.openai.com/v1'
    ).replace(/\/+$/, '');
    const key = localStorage.getItem(LS_KEY) || keyInput.value.trim();
    const model =
      localStorage.getItem(LS_MODEL) || modelInput.value.trim() || 'gpt-4o-mini';

    if (!key) {
      addMsg('sys', '请先在上方 ⚙ 设置里填写 API Key（只存你的浏览器本地）。');
      return;
    }

    addMsg('user', q);
    input.value = '';
    thinkingEl = addMsg('sys', '思考中…');

    try {
      const res = await fetch(`${base}/chat/completions`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${key}`,
        },
        body: JSON.stringify({
          model,
          messages: [
            { role: 'system', content: buildSystemPrompt() },
            { role: 'user', content: q },
          ],
        }),
      });
      if (!res.ok) {
        const t = await res.text().catch(() => '');
        throw new Error(`HTTP ${res.status} ${t.slice(0, 120)}`);
      }
      const data = await res.json();
      const reply =
        (data.choices &&
          data.choices[0] &&
          data.choices[0].message &&
          data.choices[0].message.content) ||
        '(空回复)';
      thinkingEl.className = 'msg ai';
      thinkingEl.innerHTML = esc(reply).replace(/\n/g, '<br>');
    } catch (err) {
      thinkingEl.className = 'msg sys';
      thinkingEl.textContent = `请求失败：${
        err && err.message ? err.message : err
      }。检查 base URL / Key / 模型名 / 网络。`;
    } finally {
      thinkingEl = null;
      msgs.scrollTop = msgs.scrollHeight;
    }
  }

  sendBtn.addEventListener('click', send);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') send();
  });

  addMsg(
    'sys',
    `你好，我是${signature}的站内助手。我只根据本站文章内容回答问题。先在 ⚙ 里填好你的 Key 就可以开问。`
  );
</script>
